# ===== 資料來源 =====
# 預設使用台灣官方資料源 (TWSE / TPEx), 不需要任何 API Key。
FUGLE_API_KEY=
FRED_API_KEY=
FINBRIDGE_API_KEY=

# ===== AI(可選,留空跳過 AI 功能) =====
AI_PROVIDER=openai_compat          # openai_compat | openai | codex_cli | claude_cli
AI_BASE_URL=http://127.0.0.1:8080/v1   # 任何 OpenAI 相容介面(雲端或本機 LM Studio / llama.cpp)
AI_API_KEY=
AI_MODEL=gpt-5.5

# ===== Server =====
HOST=127.0.0.1                     # 0.0.0.0 = 允許區域網路內其他裝置連線
PORT=3018
LOG_LEVEL=INFO

# ===== Auth =====
# 首次啟動時預先設定存取密碼(可選)。對外開放的伺服器部署時填入,免去 SSH 連接埠轉發設密碼。
# 僅在尚未設定密碼時生效(一次性初始化);設過後改密碼請用頁面 UI, 此處不再讀取。
# 建議至少 6 位。.env 檔案權限保持 600 且不要提交到 Git。
AUTH_PASSWORD=''

# Optional backend dependency extras for Docker and ./dev.sh / .\dev.ps1.
# Set to legacy-cpu on older CPUs without AVX2/FMA support.
BACKEND_EXTRAS=

# ===== Data =====
DATA_DIR=./data
