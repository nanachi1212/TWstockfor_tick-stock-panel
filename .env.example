# ===== 資料來源 =====
# 預設使用台灣官方資料源 (TWSE / TPEx), 不需要任何 API Key。
# 下面這個 Key 只給選配的舊 TickFlow 資料來源使用, 一般台股使用者留空即可。
TICKFLOW_API_KEY=

# ===== AI(可選,留空跳過 AI 功能) =====
AI_PROVIDER=openai_compat          # openai_compat | ollama
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_DAILY_TOKEN_BUDGET=500000

# ===== Server =====
HOST=0.0.0.0
PORT=3018
LOG_LEVEL=INFO

# ===== Auth =====
# 首次啟動時預置訪問密碼(可選)。公網服務器部署時填入,免去 SSH 端口轉發設密碼。
# 僅在尚未設置密碼時生效(一次性初始化);設過後改密碼請用頁面 UI, 此處不再讀取。
# 建議至少 6 位。.env 文件權限保持 600 且不要提交到 Git。
AUTH_PASSWORD=''

# Optional backend dependency extras for Docker and ./dev.sh / .\dev.ps1.
# Set to legacy-cpu on older CPUs without AVX2/FMA support.
# Combine with backtest as: legacy-cpu backtest
BACKEND_EXTRAS=

# ===== Data =====
DATA_DIR=./data
